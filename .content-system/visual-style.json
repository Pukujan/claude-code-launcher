  "generation_workflow": "built-in image_gen",
  "narrative_roles": [
    "hero",
    "problem",
    "supporting"
  ],
  "palette": {
    "background": "#ffffff",
    "surface": "#f5f5f5",
    "accent": "#0f766e"
  },
  "roles": {
    "hero": {
      "purpose": "show Claude Code reaching InferHub through a proxy on the same machine"
