# Copy to .env in the repository root (it is gitignored) and fill in values.
# The launchers also read other files first; see README.md for the order.
# Never commit the filled-in file.

# InferHub, required.
INFERHUB_API_KEY=
# Optional. Defaults to https://api.inferhub.dev/v1 when empty.
INFERHUB_API_URL=https://api.inferhub.dev/v1
# Optional. Not read by the launchers today; kept so every machine uses the same names.
INFERHUB_MANAGEMENT_URL=

# LiteLLM master key, optional. Leave it empty: the proxy runs keyless and
# listens on 127.0.0.1 only, and Claude Code is given the dummy key "local".
# If you set one, the proxy enforces it, the launchers hand it to Claude Code,
# and the seat hot-reload sends it.
LITELLM_MASTER_KEY=

# CKFF keys, Windows only, and only when CKFF is switched on (ckff_enabled: true
# in shared/litellm/config/inferhub_fallbacks.yaml, or CCL_CKFF=on). CKFF is off
# by default and start-litellm.ps1 does not need them then. On the PC they live in
# configs\.env on the Desktop (the launcher checks the Desktop known folder,
# %USERPROFILE%\Desktop and %OneDrive%\Desktop) under these names:
# ckff-cortex-default=
# ckff-cortex-grok=
# ckff-kiro-pro=
# ckff_cortex_kimi_token_=
# ckff-cortex-gemini_cli=
# ckff-cortex-codex-CC=
# ckff-cortex-codex-plus=
# ckff-cortex-codex-pro=
# ckff-cortex-image-generation=
# ckff_cortex_embedder_rerank=

# Per-PC proxy settings go in shared/litellm/.env.local (also gitignored), which
# windows\litellm\start-litellm.ps1 loads last. Example (see docs/HOOKS.md):
# CCL_WEB_SEARCH_CHAIN=searxng,tinyfish,ddgs,you_com,tavily,exa
# SEARXNG_API_BASE=http://127.0.0.1:18080
# CCL_ENV_ALIASES=TINYFISH_API_KEY=<key name in another env file>,TAVILY_API_KEY=<key name>,EXA_API_KEY=<key name>